{
  "info": {
    "name": "Credit Card Payment System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 'Register' and 'Login' first; tokens/ids are stored automatically. Use the admin login for the Admin folder."
  },
  "variable": [
    {
      "key": "django",
      "value": "http://localhost:8000"
    },
    {
      "key": "fastapi",
      "value": "http://localhost:8001"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "card_id",
      "value": ""
    },
    {
      "key": "reference",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth (Django)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/auth/register/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo2\",\n  \"email\": \"demo2@example.com\",\n  \"password\": \"Str0ng!Passw0rd\",\n  \"password2\": \"Str0ng!Passw0rd\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/auth/login/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo2\",\n  \"password\": \"Str0ng!Passw0rd\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('access', j.access);",
                  "pm.environment.set('refresh', j.refresh);",
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/auth/login/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('access', j.access);",
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/auth/refresh/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            }
          }
        },
        {
          "name": "Me (protected)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/auth/me/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/auth/logout/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Cards (Django)",
      "item": [
        {
          "name": "Add card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/cards/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_holder_name\": \"Demo User\",\n  \"card_type\": \"CREDIT\",\n  \"card_number\": \"4111 1111 1111 1111\",\n  \"cvv\": \"123\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2035\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('card_id', j.id);",
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List cards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/cards/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete card",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{django}}/api/cards/{{card_id}}/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Payments (FastAPI)",
      "item": [
        {
          "name": "Make payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{fastapi}}/payments"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": \"250.75\",\n  \"currency\": \"INR\",\n  \"description\": \"Test order\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('reference', j.reference);",
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('final status', () => pm.expect(['SUCCESS','FAILED']).to.include(j.status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fastapi}}/payments/{{reference}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Recent payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fastapi}}/payments?limit=10"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fastapi}}/health"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "4. Transactions (Django)",
      "item": [
        {
          "name": "History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/transactions/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "History filtered",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/transactions/?status=SUCCESS&min_amount=100&max_amount=1000&date_from=2026-01-01&date_to=2030-12-31"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin export CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/transactions/admin/export/?status=SUCCESS"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin (Django)",
      "item": [
        {
          "name": "Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/admin/users/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django}}/api/admin/users/2/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            }
          }
        },
        {
          "name": "Cards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/admin/cards/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/admin/transactions/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Daily summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/admin/daily-summary/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Admin logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django}}/api/admin/logs/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}